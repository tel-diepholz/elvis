{
  "name": "@elvis/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "ELVIS lite – ELVIS als Desktop-App für Windows (ELW 1)",
  "author": "ELVIS",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run build -w @elvis/web && tsup",
    "start": "npm run build && electron .",
    "dev": "tsup && cross-env ELVIS_DEV_URL=http://localhost:5173 electron .",
    "typecheck": "tsc -p .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dockerode": "^4.0.12",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@elvis/server": "*",
    "@elvis/shared": "*",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "tsup": "^8.3.5"
  }
}
